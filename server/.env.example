# Copy this file to .env and fill in real values before running the server.

# Port the API + static site is served on
PORT=4000

# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add http://localhost:4000 as an authorized origin
# while testing, and https://aifico.com when you deploy.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Any long random string — used to sign session tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Set to "true" once you're serving the site over HTTPS (production),
# so the session cookie is marked Secure.
COOKIE_SECURE=false
